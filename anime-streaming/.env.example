# Copy to .env.local (or .env) and fill in. Every value below has a working
# localhost default in code except the two external API keys, which are required
# for subtitle/metadata lookups.

# ── Backend ──────────────────────────────────────────────────────────────────
# Spring Boot origin used by the browser clients (src/lib/*) and by the server
# routes in src/app/api (auth cookies are forwarded to it).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Anime catalogue endpoint (full path, not just the origin).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1/animes

# ── Social sign-in ───────────────────────────────────────────────────────────
# Must be the same client id configured on the backend as
# ANIFIRE_OAUTH_GOOGLE_CLIENT_ID; the Google button is hidden when unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── External media APIs (server-side only, never exposed to the browser) ─────
# TMDB: artwork and title metadata. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Jimaku: Japanese subtitle files. https://jimaku.cc/
JIMAKU_API_KEY=

# ── Local AI (Ollama) ────────────────────────────────────────────────────────
# Used by /api/ai-review and /api/translate-subs. Both routes fail soft when the
# host is unreachable, so these are optional for a catalogue-only run.
OLLAMA_HOST=http://localhost:11434
OLLAMA_REVIEW_MODEL=qwen2.5:3b
OLLAMA_TRANSLATE_MODEL=qwen2.5:3b
