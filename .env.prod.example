# Copy to .env.prod (never commit it) and fill in.
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build

# Public host name; Caddy obtains the TLS certificate for it automatically.
ANIFIRE_DOMAIN=anifire.example.ru

POSTGRES_DB=anifire
POSTGRES_USER=anifire
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Object storage for uploads (MinIO in the stack). openssl rand -hex 24 for the password.
MINIO_ROOT_USER=anifire
MINIO_ROOT_PASSWORD=

# Off-site copy of the nightly database backups. Leave empty to keep them in the
# local MinIO `backups` bucket only (same host — not a real off-site backup).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# openssl rand -base64 32
ANIFIRE_SECURITY_PEPPER=
# base64 of the signing JWK JSON. Generate once and keep it: changing it signs
# everyone out. E.g. run the backend locally once and use
#   base64 < anime-backend/anime-backend/auth-keys/signing-jwk.json | tr -d '\n'
ANIFIRE_JWT_JWK_SET=

# SMTP relay (Unisender Go, Yandex 360, Mailgun, SES, ...). STARTTLS on 587.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
ANIFIRE_MAIL_FROM=Anifire <no-reply@anifire.example.ru>

# YooKassa
ANIFIRE_BILLING_SHOP_ID=
ANIFIRE_BILLING_SECRET_KEY=

# Optional
# Error reporting to Sentry or a self-hosted GlitchTip (same DSN for API and site).
SENTRY_DSN=
GOOGLE_CLIENT_ID=
TMDB_API_KEY=
JIMAKU_API_KEY=
OLLAMA_HOST=
